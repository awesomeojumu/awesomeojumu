# Production — awesomeojumu.com
# Copy to .env on the server (never commit .env)

APP_NAME="Awesome Ojumu"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://awesomeojumu.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# No database required for this site (sessions/cache use files)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=awesomeojumu.com
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Contact form — use your host SMTP (cPanel Email, Gmail app password, Mailgun, etc.)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@awesomeojumu.com
MAIL_FROM_NAME="Awesome Ojumu"
MAIL_CONTACT_TO=planexiglobalconsult@gmail.com

ASSET_VERSION=3
